@model Queue<Producto>
@{
    ViewData["Title"] = "Panel Principal";
}

<!-- Hero Banner estilo Image 2 -->
<div class="axis-hero-banner">
    <div class="row align-items-center">
        <div class="col-12 col-lg-8">
            <span class="badge-axis-cafe mb-2 d-inline-block">✦ AXIS WORKSPACE</span>
            <h1 class="display-5 mb-2">Control de Inventario y Punto de Venta</h1>
            <p class="mb-3" style="color: var(--cafe-medio);">
                Administra existencias, registra ventas en tiempo real y supervisa alertas de reposición.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Ventas" asp-action="Nueva" class="btn btn-axis-primary">+ Registrar Nueva Venta</a>
                <a asp-controller="Productos" asp-action="Index" class="btn btn-axis-cafe">Explorar Catálogo</a>
            </div>
        </div>
    </div>
</div>

<!-- Bento Grid KPIs estilo Image 3 -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="bento-card h-100">
            <div class="small text-uppercase fw-bold" style="color: var(--cafe-medio);">Productos</div>
            <div class="axis-serif display-5 mt-1">@ViewBag.TotalProductos</div>
            <span class="badge-axis-celeste small">En catálogo</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bento-card-celeste h-100">
            <div class="small text-uppercase fw-bold" style="color: var(--cafe-medio);">Unidades Stock</div>
            <div class="axis-serif display-5 mt-1">@ViewBag.TotalUnidadesStock</div>
            <span class="badge-axis-cafe small">Disponibles</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bento-card h-100">
            <div class="small text-uppercase fw-bold" style="color: var(--cafe-medio);">Ventas</div>
            <div class="axis-serif display-5 mt-1">@ViewBag.TotalVentasRealizadas</div>
            <span class="badge-axis-celeste small">Facturadas</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bento-card-cafe h-100">
            <div class="small text-uppercase fw-bold" style="color: var(--celeste-suave);">Ingresos Totales</div>
            <div class="axis-serif h2 mt-2 mb-1 text-white">$@(((decimal)ViewBag.IngresosTotales).ToString("N0"))</div>
            <span class="small" style="color: var(--celeste-medio);">✦ Balance acumulado</span>
        </div>
    </div>
</div>

<!-- Tabla estilo Assignment Tracker (Image 1) -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="mb-0">✹ Alertas de Reposición (Cola Prioritaria)</h3>
</div>

@if (!Model.Any())
{
    <div class="bento-card-celeste">✦ Todo el inventario cuenta con existencias óptimas.</div>
}
else
{
    <div class="tracker-table-wrapper">
        <table class="table tracker-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Stock Actual</th>
                    <th>Stock Mínimo</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong>@p.Codigo</strong></td>
                        <td>@p.Nombre</td>
                        <td class="fw-bold">@p.Stock und.</td>
                        <td>@p.StockMinimo und.</td>
                        <td><span class="badge-axis-cafe">★ @p.EstadoInventario()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
